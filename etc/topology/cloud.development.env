# cloud.development - configure deployed development API URLs before use
SDKWORK_SANDBOX_DEPLOYMENT_PROFILE=cloud
SDKWORK_SANDBOX_ENVIRONMENT=development
SDKWORK_SANDBOX_PROFILE_ID=cloud.development


# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_SANDBOX_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN

SDKWORK_SANDBOX_PLATFORM_API_GATEWAY_HTTP_URL=https://api.sdkwork.com
VITE_SDKWORK_SANDBOX_PLATFORM_API_GATEWAY_HTTP_URL=https://api.sdkwork.com
