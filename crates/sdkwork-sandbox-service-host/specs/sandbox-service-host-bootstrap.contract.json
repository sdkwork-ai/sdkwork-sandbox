{
  "schemaVersion": 1,
  "kind": "sdkwork.sandbox.service-host-bootstrap-contract",
  "status": "draft",
  "requirementId": "REQ-2026-0009",
  "relatedRequirementIds": ["REQ-2026-0005", "REQ-2026-0010"],
  "adr": "../../../docs/architecture/decisions/ADR-20260729-sandbox-service-host-composition-and-readiness.md",
  "review": "../../../docs/engineering/reviews/REVIEW-20260729-sandbox-service-host-composition-and-readiness.md",
  "component": "sdkwork-sandbox-service-host",
  "layerRole": "runtime-service-host",
  "implementationAuthorized": false,
  "ownership": {
    "sandbox_source_config_owner": "future-approved-sandbox-runtime-bootstrap",
    "sandbox_normalized_config_owner": "sdkwork-sandbox-service-host",
    "sandbox_runtime_directory_capability_owner": "future-approved-sandbox-runtime-bootstrap",
    "sandbox_database_pool_and_credential_owner": "approved-database-composition",
    "sandbox_repository_port_owner": "sdkwork-intelligence-sandbox-service",
    "sandbox_secret_material_owner": "approved-platform-secret-manager",
    "sandbox_secret_key_adapter_owner": "future-approved-sandbox-secret-key-adapter",
    "sandbox_telemetry_adapter_owner": "future-approved-sandbox-telemetry-adapter",
    "sandbox_audit_and_outbox_owner": "future-approved-sandbox-audit-outbox-runtime",
    "sandbox_provider_registry_owner": "future-approved-sandbox-provider-composition",
    "sandbox_service_host_owns_database_pool": false,
    "sandbox_service_host_owns_database_migration": false,
    "sandbox_service_host_owns_secret_resolution": false,
    "sandbox_service_host_owns_telemetry_exporter": false
  },
  "sourceConfig": {
    "type": "SandboxServiceHostSourceConfig",
    "sandbox_primary_authority": "source-etc-profile",
    "sandbox_profile_id_format": "{sandbox_deployment_profile}.{sandbox_environment}",
    "sandbox_supported_profile_ids": [
      "standalone.development",
      "standalone.test",
      "standalone.staging",
      "standalone.production",
      "cloud.development",
      "cloud.test",
      "cloud.staging",
      "cloud.production"
    ],
    "sandbox_runtime_target": "server",
    "sandbox_safe_deployment_overrides_allowed_at_bootstrap": true,
    "sandbox_safe_config_precedence": [
      "source-etc-profile",
      "installed-operator-config",
      "process-environment-safe-overrides",
      "cli-safe-overrides"
    ],
    "sandbox_override_source_provenance_required": true,
    "sandbox_unknown_override_key_rejected": true,
    "sandbox_secret_resolution_is_separate_from_safe_config_precedence": true,
    "sandbox_service_host_reads_process_environment": false,
    "sandbox_profile_identity_override_allowed": false,
    "sandbox_unknown_profile_fallback_allowed": false,
    "sandbox_cloud_to_standalone_fallback_allowed": false,
    "sandbox_production_to_nonproduction_fallback_allowed": false,
    "sandbox_source_etc_materialization_authorized": false,
    "sandbox_allowed_safe_fields": [
      "sandbox_profile_id",
      "sandbox_deployment_profile",
      "sandbox_environment",
      "sandbox_runtime_target",
      "sandbox_readiness_timeout_ms",
      "sandbox_shutdown_timeout_ms",
      "sandbox_required_capabilities",
      "sandbox_required_isolation_assurance",
      "sandbox_database_budget_profile",
      "sandbox_secret_budget_profile",
      "sandbox_telemetry_budget_profile"
    ],
    "sandbox_forbidden_fields": [
      "sandbox_database_url",
      "sandbox_database_password",
      "sandbox_redis_url",
      "sandbox_redis_password",
      "sandbox_secret_material",
      "sandbox_raw_key",
      "sandbox_token",
      "sandbox_private_key",
      "sandbox_physical_runtime_path",
      "sandbox_provider_allocation_reference",
      "sandbox_tenant_id",
      "sandbox_user_id"
    ],
    "sandbox_forbidden_sources": [
      "dotenv",
      "agent.app.config.json-runtime-values",
      "committed-secret-file",
      "source-checkout-metadata",
      "global-mutable-state",
      "implicit-profile-default"
    ]
  },
  "normalizedConfig": {
    "type": "SandboxServiceHostConfig",
    "candidatePublicExportAuthorized": false,
    "sandbox_profile_id_matches_deployment_profile_and_environment": true,
    "sandbox_runtime_target_is_server": true,
    "sandbox_unknown_field_rejected": true,
    "sandbox_duplicate_field_rejected": true,
    "sandbox_all_timeouts_nonzero_and_bounded": true,
    "sandbox_capabilities_deduplicated_and_bounded": true,
    "sandbox_minimum_assurance_explicit": true,
    "sandbox_contains_secret_material": false,
    "sandbox_contains_database_connection_material": false,
    "sandbox_contains_physical_runtime_paths": false
  },
  "compositionInputs": {
    "type": "SandboxServiceHostCompositionInputs",
    "candidatePublicExportAuthorized": false,
    "sandbox_required_inputs": [
      "SandboxServiceHostConfig",
      "SandboxRuntimeDirectoryCapabilities",
      "SandboxSessionRepository",
      "SandboxProviderRegistry",
      "SandboxWorkspaceAttachmentPort",
      "SandboxSecretKeySource",
      "SandboxTelemetryPort",
      "SandboxClock",
      "SandboxIdGenerator"
    ],
    "sandbox_inputs_are_preconstructed_or_opened": true,
    "sandbox_missing_input_fails_before_serving": true,
    "sandbox_input_identity_and_profile_match_required": true,
    "sandbox_concrete_sqlx_pool_exposed_to_service_host": false,
    "sandbox_raw_secret_value_exposed_to_service_host": false,
    "sandbox_raw_runtime_path_exposed_to_service_host": false
  },
  "runtimeDirectoryCapabilities": {
    "type": "SandboxRuntimeDirectoryCapabilities",
    "sandbox_application_code": "sandbox",
    "sandbox_required_roles": [
      "sandbox_runtime_state",
      "sandbox_temporary",
      "sandbox_cache",
      "sandbox_logs"
    ],
    "sandbox_opened_by_runtime_bootstrap": true,
    "sandbox_handle_relative_access_required": true,
    "sandbox_no_follow_required": true,
    "sandbox_file_identity_verification_required": true,
    "sandbox_least_privilege_permissions_required": true,
    "sandbox_role_handles_must_not_alias": true,
    "sandbox_source_checkout_path_allowed": false,
    "sandbox_arbitrary_host_root_allowed": false,
    "sandbox_id_to_path_derivation_allowed": false,
    "sandbox_string_canonicalization_is_security_boundary": false,
    "sandbox_physical_path_observation_allowed": false
  },
  "secretBoundary": {
    "sandbox_source_config_contains_secret_material": false,
    "sandbox_normalized_config_contains_secret_material": false,
    "sandbox_secret_provider_uses_injected_workload_identity_or_protected_handle": true,
    "sandbox_ambient_cloud_or_host_credentials_allowed": false,
    "sandbox_secret_values_in_host_or_bootstrap_process_environment_allowed": false,
    "sandbox_guest_or_command_secret_injection_defined_or_authorized": false,
    "sandbox_secret_values_in_cli_arguments_allowed": false,
    "sandbox_secret_values_in_logs_metrics_traces_events_or_readiness_allowed": false,
    "sandbox_secret_values_in_debug_output_allowed": false,
    "sandbox_key_material_uses_zeroizing_carrier": true,
    "sandbox_key_id_and_version_are_nonsecret_bounded_metadata": true,
    "sandbox_key_id_version_material_immutability_required": true,
    "sandbox_revoked_or_unknown_key_is_ready": false,
    "sandbox_synchronous_remote_kms_on_async_executor_allowed": false,
    "sandbox_remote_secret_operations_are_bounded_and_cancellable": true,
    "sandbox_secret_cache_is_process_private_and_bounded": true,
    "sandbox_secret_cache_persistence_allowed": false,
    "sandbox_secret_release_or_zeroization_on_shutdown_required": true
  },
  "databaseComposition": {
    "sandbox_authoritative_engine": "postgresql",
    "sandbox_database_composition_injects_repository_port": true,
    "sandbox_service_host_constructs_pool": false,
    "sandbox_service_host_receives_database_url_or_password": false,
    "sandbox_service_host_runs_migrations": false,
    "sandbox_memory_or_sqlite_server_fallback_allowed": false,
    "sandbox_profile_connection_budget_required": true,
    "sandbox_profile_connection_budget_exact_values_approved": false,
    "sandbox_connection_budget_bounds": {
      "sandbox_max_connections_min": 1,
      "sandbox_max_connections_max": 256,
      "sandbox_connect_timeout_ms_min": 1,
      "sandbox_connect_timeout_ms_max": 30000,
      "sandbox_acquire_timeout_ms_min": 1,
      "sandbox_acquire_timeout_ms_max": 30000,
      "sandbox_idle_timeout_seconds_max": 3600,
      "sandbox_statement_timeout_ms_max": 300000
    },
    "sandbox_pool_readiness_must_precede_repository_injection": true,
    "sandbox_pool_or_repository_readiness_output_contains_connection_material": false,
    "sandbox_redis_enabled": false,
    "sandbox_redis_enablement_requires_separate_ready_requirement": true,
    "sandbox_implicit_cache_dependency_allowed": false
  },
  "telemetryBoundary": {
    "sandbox_adapter_required_before_serving": true,
    "sandbox_adapter_readiness_requires_bounded_acceptance_redaction_and_drop_accounting": true,
    "sandbox_structured_redacted_observation_required": true,
    "sandbox_low_cardinality_labels_required": true,
    "sandbox_operational_export_uses_bounded_buffer": true,
    "sandbox_operational_export_drop_counter_required": true,
    "sandbox_exporter_outage_may_be_degraded_when_buffer_policy_holds": true,
    "sandbox_exporter_degradation_is_separate_operational_health": true,
    "sandbox_exporter_degradation_does_not_degrade_required_adapter_readiness_when_buffer_policy_holds": true,
    "sandbox_buffer_policy_failure_makes_adapter_not_ready": true,
    "sandbox_exporter_outage_may_disable_redaction_or_drop_accounting": false,
    "sandbox_metrics_logs_or_traces_are_audit_authority": false,
    "sandbox_console_log_is_audit_or_outbox_authority": false,
    "sandbox_security_audit_and_business_event_loss_allowed": false,
    "sandbox_audit_outbox_readiness_is_separate_dependency": true,
    "sandbox_buffer_budget_bounds": {
      "sandbox_buffer_items_max": 10000,
      "sandbox_buffer_bytes_max": 16777216,
      "sandbox_flush_timeout_ms_max": 10000
    }
  },
  "bootstrapOrder": {
    "sandbox_stages": [
      "sandbox_parse_and_normalize_safe_source_config",
      "sandbox_validate_profile_identity_and_bounds",
      "sandbox_open_runtime_directory_capabilities",
      "sandbox_initialize_secret_provider_and_key_source",
      "sandbox_initialize_database_composition_and_repository",
      "sandbox_initialize_telemetry_adapter",
      "sandbox_initialize_provider_registry_and_workspace_attachment",
      "sandbox_construct_service_host",
      "sandbox_evaluate_contract_profile_and_capability_gates",
      "sandbox_mark_serving"
    ],
    "sandbox_stage_order_is_fixed": true,
    "sandbox_stage_deadline_required": true,
    "sandbox_total_bootstrap_timeout_ms_max": 60000,
    "sandbox_partial_initialization_may_mark_serving": false,
    "sandbox_failure_releases_initialized_resources_in_reverse_order": true,
    "sandbox_failure_cleanup_is_bounded": true,
    "sandbox_cleanup_uncertainty_requires_operator_visible_not_ready": true,
    "sandbox_retry_requires_fresh_normalization_and_dependency_readiness": true
  },
  "shutdownOrder": {
    "sandbox_stop_new_lifecycle_side_effects_first": true,
    "sandbox_stages": [
      "sandbox_stop_accepting_work",
      "sandbox_release_provider_leases_and_resources",
      "sandbox_flush_bounded_operational_telemetry",
      "sandbox_release_repository_and_database_composition",
      "sandbox_release_and_zeroize_secret_handles",
      "sandbox_close_runtime_directory_capabilities"
    ],
    "sandbox_idempotent": true,
    "sandbox_deadline_required": true,
    "sandbox_timeout_is_operator_visible_failure": true
  },
  "readiness": {
    "sandbox_failure_mode": "fail-closed",
    "sandbox_required_dimensions": [
      "sandbox_source_config",
      "sandbox_runtime_directory_capabilities",
      "sandbox_secret_key_source",
      "sandbox_repository",
      "sandbox_telemetry_adapter",
      "sandbox_audit_outbox_dependency",
      "sandbox_provider_registry",
      "sandbox_composition_profile_and_capabilities"
    ],
    "sandbox_states": ["ready", "not-ready", "degraded", "unknown"],
    "sandbox_unknown_is_ready": false,
    "sandbox_degraded_required_dependency_is_ready": false,
    "sandbox_readiness_is_bounded_and_repeatable": true,
    "sandbox_safe_fields": [
      "sandbox_dependency",
      "sandbox_outcome",
      "sandbox_reason_code",
      "sandbox_duration_ms",
      "sandbox_trace_id",
      "sandbox_checked_at"
    ]
  },
  "requiredHumanDecisions": [
    "sandbox_runtime_bootstrap_owner_and_component_identity",
    "sandbox_source_etc_schema_and_safe_override_allowlist",
    "sandbox_runtime_directory_capability_type_and_permissions",
    "sandbox_secret_manager_and_workload_identity_adapter",
    "sandbox_secret_operation_and_cache_budgets",
    "sandbox_database_connection_budgets_per_profile",
    "sandbox_telemetry_buffer_and_outage_policy",
    "sandbox_audit_outbox_runtime_owner",
    "sandbox_bootstrap_and_shutdown_deadlines"
  ],
  "requiredImplementationEvidence": [
    "sandbox_eight_profile_normalization_matrix",
    "sandbox_unknown_or_mismatched_profile_negative_tests",
    "sandbox_config_secret_path_and_connection_material_scan",
    "sandbox_runtime_directory_capability_escape_and_alias_tests",
    "sandbox_secret_rotation_revocation_timeout_and_zeroization_tests",
    "sandbox_database_pool_budget_and_no_fallback_tests",
    "sandbox_telemetry_backpressure_drop_accounting_and_redaction_tests",
    "sandbox_bootstrap_fault_injection_for_every_stage",
    "sandbox_reverse_cleanup_and_shutdown_timeout_tests"
  ],
  "forbiddenOwnership": [
    "http-listener",
    "api-route",
    "generated-sdk",
    "provider-mechanism",
    "database-driver-or-pool",
    "database-migration",
    "secret-manager-or-kms-mechanism",
    "telemetry-exporter",
    "audit-outbox-runtime",
    "scheduler-policy",
    "deployment-profile-materialization"
  ],
  "x-sdkwork-status": "draft",
  "x-sdkwork-require-human-review": true,
  "x-sdkwork-no-runtime-implementation": true,
  "x-sdkwork-no-config-or-etc-materialization": true,
  "x-sdkwork-no-secret-kms-implementation": true,
  "x-sdkwork-no-database-or-cache-implementation": true,
  "x-sdkwork-no-telemetry-or-outbox-implementation": true,
  "x-sdkwork-no-deployment": true
