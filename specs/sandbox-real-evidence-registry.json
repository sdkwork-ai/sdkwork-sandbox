  "purpose": [
    "The Gate 0 contracts in specs/ name 127 evidence ids that they require before a Provider may be implemented,",
    "but nothing in the repository declared who or what is supposed to produce any of them. A required piece of",
    "evidence with no producer is a silent gap: it looks satisfied because nothing fails.",
    "This registry is the traceability authority for that gap. It snapshots every required evidence id per contract,",
    "records the two ids for which this repository can produce a host-precondition half, and makes the size of the",
    "human- and real-runner-gated remainder an explicit, drift-checked number."
  ],
  "doesNotAuthorize": [
    "a Provider, Provider Port, API route, HTTP route, SDK, scheduler, isolation policy, secret injection, deployable",
    "profile, runtime dependency change, process spawn, host I/O, public port, cgroup, namespace, netns, Tap, firewall, or MicroVm"
  ],
  "producerClasses": {
    "host-precondition-facts": {
      "description": "Read-only host facts that tools/testing/sandbox-host-capability-evidence.mjs can observe and classify.",
      "satisfiesEvidence": false,
      "note": "Host facts are an input to real-runner conformance, never a substitute for it."
    },
    "real-runner-required": {
      "description": "Evidence that can only come from executing the real path (process spawn, filesystem races, VM lifecycle, network policy, crash recovery) on reviewable hardware.",
      "satisfiesEvidence": false,
      "note": "Requires a human-owned runner, a reproducible bootstrap and the review packet each contract names."
    },
    "human-review-required": {
      "description": "Evidence that is an accepted review outcome rather than machine output.",
      "satisfiesEvidence": false
    }
  },
