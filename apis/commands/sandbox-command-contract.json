{
  "schemaVersion": 1,
  "kind": "sdkwork.sandbox.command-contract",
  "status": "draft",
  "implementationAuthorized": true,
  "requirementId": "REQ-2026-0007",
  "adr": "../../docs/architecture/decisions/ADR-20260729-sandbox-command-execution-and-terminal-boundary.md",
  "review": "../../docs/engineering/reviews/REVIEW-20260729-sandbox-command-execution-architecture-security.md",
  "requestSchema": "./sandbox-command-execution-request.schema.json",
  "cancellationRequestSchema": "./sandbox-command-cancellation-request.schema.json",
  "resultSchema": "./sandbox-command-execution-result.schema.json",
  "errorSchema": "./sandbox-command-execution-error.schema.json",
  "executionModes": ["executable-argv"],
  "forbiddenExecutionModes": [
    "shell-string",
    "implicit-shell",
    "interactive-pty",
    "network",
    "browser",
    "port-forward",
    "secret-injection"
  ],
  "executableResolution": {
    "type": "SandboxExecutableResolutionPolicy",
    "logicalIdentifierField": "sandboxExecutable",
    "callerSuppliedPathAllowed": false,
    "operatingSystemPathSearchAllowed": false,
    "workingDirectoryLookupAllowed": false,
    "providerOwnedRegistryRequired": true,
    "registrySnapshotBoundToRuntimeBinding": true,
    "registrySnapshotImmutableForBindingLifetime": true,
    "resolvedExecutableIdentityIsProviderPrivate": true,
    "replayResolvedExecutableIdentityMustMatchOriginal": true,
    "missingResolutionBeforeStartOutcome": "command-not-found",
    "changedOrUnavailableReplayOutcome": "result-unavailable-no-reexecution"
  },
  "environmentPolicy": {
    "type": "SandboxCommandEnvironmentPolicy",
    "finalEnvironmentStartsEmpty": true,
    "requestMayExtendNameAllowlist": false,
    "requestValuesRequirePerNameValidation": true,
    "protectedRequestNames": [
      "PATH",
      "PATHEXT",
      "COMSPEC",
      "SYSTEMROOT",
      "WINDIR",
      "HOME",
      "USERPROFILE",
      "TMP",
      "TEMP"
    ],
    "sensitiveRequestNameSegments": [
      "TOKEN",
      "SECRET",
      "PASSWORD",
      "CREDENTIAL",
      "PRIVATE",
      "SSH",
      "DOCKER",
      "AWS",
      "AZURE",
      "GOOGLE",
      "PROXY"
    ],
    "providerFixedValuesInjectedAfterRequestValidation": true,
    "callerMayOverrideProviderFixedValues": false,
    "policySnapshotBoundToRuntimeBinding": true,
    "policySnapshotImmutableForBindingLifetime": true,
    "ambientEnvironmentInheritanceAllowed": false
  },
  "bounds": {
    "maxArgumentCount": 128,
    "maxExecutableBytes": 128,
    "maxArgumentBytes": 4096,
    "maxWorkingDirectoryBytes": 512,
    "maxEnvironmentEntries": 64,
    "maxEnvironmentNameBytes": 64,
    "maxEnvironmentValueBytes": 1024,
    "maxCanonicalRequestBytes": 614400,
    "maxStdoutBytes": 67108864,
    "maxStderrBytes": 67108864,
    "maxProcessCount": 128,
    "maxTimeoutMs": 86400000,
    "maxCleanupTimeoutMs": 60000
  },
  "errorCodes": [
    { "code": "invalid-request", "retryable": false, "category": "validation" },
    { "code": "unsupported-capability", "retryable": false, "category": "capability" },
    { "code": "policy-denied", "retryable": false, "category": "security" },
    { "code": "stale-fencing", "retryable": true, "category": "concurrency", "retryPrerequisite": "new-fencing-authority" },
    { "code": "idempotency-conflict", "retryable": false, "category": "concurrency" },
    { "code": "operation-in-progress", "retryable": true, "category": "concurrency", "retryPrerequisite": "same-operation-and-fingerprint" },
    { "code": "command-not-found", "retryable": false, "category": "execution" },
    { "code": "provider-unavailable", "retryable": true, "category": "provider", "retryPrerequisite": "same-operation-and-fingerprint" },
    { "code": "result-unavailable", "retryable": true, "category": "reliability", "retryPrerequisite": "same-operation-and-fingerprint" },
    { "code": "internal-failure", "retryable": false, "category": "internal" }
  ],
  "terminalOutcomes": [
    "succeeded",
    "failed",
    "timed-out",
    "cancelled",
    "output-limit",
    "resource-exhausted",
    "fencing-lost"
  ],
  "fingerprint": {
    "algorithm": "sha256",
    "domainSeparation": "sdkwork-sandbox-command-v1",
    "canonicalEncoding": "versioned-length-prefixed-utf8-and-u64be",
    "environmentOrdering": "environment-name-ascending",
    "argumentOrdering": "preserve",
    "authority": "sandbox-service-derived",
    "executorRecomputationRequired": true,
    "callerOverrideAllowed": false,
    "traceIdIncluded": false,
    "executionFields": [
      "tenantId",
      "sandboxProviderId",
      "sandboxWorkspaceId",
      "sandboxSessionId",
      "sandboxId",
      "sandboxRuntimeBindingId",
      "sandboxFencingToken",
      "sandboxCommandOperationId",
      "sandboxExecutable",
      "sandboxArguments",
      "sandboxWorkingDirectory",
      "sandboxEnvironment",
      "sandboxCommandLimits"
    ],
    "cancellationFields": [
      "tenantId",
      "sandboxProviderId",
      "sandboxWorkspaceId",
      "sandboxSessionId",
      "sandboxId",
      "sandboxRuntimeBindingId",
      "sandboxFencingToken",
      "sandboxCommandOperationId",
      "sandboxCancellationOperationId"
    ]
  },
  "idempotency": {
    "executionKey": ["tenantId", "sandboxProviderId", "sandboxCommandOperationId"],
    "cancellationKey": ["tenantId", "sandboxProviderId", "sandboxCancellationOperationId"],
    "sameFingerprintCompleted": "replay-terminal-result-with-sandboxCommandResultReplayed-true",
    "sameFingerprintInProgress": "operation-in-progress",
    "differentFingerprint": "idempotency-conflict",
    "automaticNewOperationRetryAllowed": false,
    "completedResultRetentionMustBeBoundedAndDurableForHa": true
  },
  "terminalArbitration": {
    "authority": "executor-durable-first-terminal-cas",
    "firstPersistedPrimaryTerminalFactWins": true,
    "laterTerminalSignalsCannotRewritePrimaryOutcome": true,
    "laterCancellationReturnsPersistedTerminalResult": true,
    "terminalResultIsPersistedAfterBoundedCleanup": true,
    "cleanupFailureDoesNotHideOrRewritePrimaryOutcome": true,
    "cleanupFailureRequiresBindingQuarantineAndProviderUnavailability": true
  },
  "completion": {
    "acceptedExecutionReturnsTerminalResult": true,
    "preStartOrAuthoritativeResultUnavailableReturnsError": true,
    "timeoutCancellationOutputAndResourceLimitsAreTerminalResults": true,
    "blindRetryAfterTerminalOutcomeAllowed": false,
    "cancelCompletedCommandReturnsExistingTerminalResult": true,
    "cancellationReturnsTargetTerminalExecutionResult": true,
    "cancelUnknownCommandReturns": "command-not-found",
    "outputLimitRequiresAtLeastOneTruncatedStream": true,
    "truncatedStreamRequiresOutputLimitOutcome": true,
    "capturedByteCountsMatchDecodedOutput": true,
    "interruptedOutcomeRequiresCleanupAttempt": true,
    "cleanupFailureIsExplicitAndNotBlindlyRetryable": true
  },
  "conformanceScenarios": [
    "typed-executable-and-argv-preservation",
    "shell-string-rejection",
    "logical-working-directory-escape-rejection",
    "deny-by-default-environment",
    "timeout-and-descendant-cleanup",
    "cancellation-and-descendant-cleanup",
    "stdout-and-stderr-hard-bounds",
    "stale-fencing-fail-closed",
    "derived-fingerprint-recomputation-and-mismatch-rejection",
    "same-operation-same-fingerprint-replay",
    "same-operation-different-fingerprint-conflict",
    "in-progress-operation-does-not-spawn-duplicate",
    "fenced-idempotent-cancellation-request",
    "accepted-execution-terminal-result-error-partition",
    "terminal-race-single-winner-and-replay",
    "cleanup-failure-visible-and-binding-quarantined",
    "safe-error-and-private-metadata-redaction",
    "provider-owned-executable-resolution-without-path-search",
    "protected-environment-override-rejection",
    "runtime-binding-policy-snapshot-immutability"
  ],
  "x-sdkwork-status": "draft",
  "x-sdkwork-no-host-io": true,
  "x-sdkwork-require-human-review": true
}
