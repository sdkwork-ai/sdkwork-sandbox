{
  "openapi": "3.1.2",
  "info": {
    "title": "SDKWork Sandbox App API",
    "version": "1.0.0",
    "description": "Authoritative OpenAPI contract for the SDKWork Sandbox app-api console face, aligned with API_SPEC.md (SDKWork v3 wire profile) and the runtime route crate sdkwork-routes-sandbox-app-api. REQ-2026-0030 covers the per-user sandbox instance registry as a browser-facing surface: every operation is IAM dual-token authenticated, the tenant and the owner are derived server-side from the verified principal (API_SPEC.md section 12), and the listing is always narrowed to the calling owner. The operator-trusted tenant-wide inventory remains the internal-api face (apis/internal-api/intelligence/); this document never widens that scope.",
    "x-sdkwork-owner": "sdkwork-sandbox",
    "x-sdkwork-api-authority": "sdkwork-sandbox-app-api"
  },
  "x-sdkwork-authority": {
    "requirementId": "REQ-2026-0030",
    "decisionId": "ADR-20261004",
    "apiSurface": "app-api",
    "wireProtocol": "sdkwork-v3"
  },
  "servers": [
    {
      "url": "/",
      "description": "Same-origin root; the app-api prefix is part of every path (route crates mount /app/v3/api only)"
    }
  ],
  "tags": [
    {
      "name": "sandbox",
      "description": "Per-user sandbox instance registry (console face)"
    }
  ],
  "paths": {
    "/app/v3/api/sandbox/sandbox_instances": {
      "get": {
        "tags": [
          "sandbox"
        ],
        "summary": "Lists the sandbox instances owned by the authenticated user",
        "operationId": "sandboxInstances.list",
        "description": "Offset-paged listing narrowed to the calling owner (PAGINATION_SPEC.md section 3 offset mode). Out-of-range pagination values are rejected with 400; never clamped.",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 1,
              "maximum": 10000,
              "default": 1
            },
            "description": "1-based page number. Values above 10000 reject with 400; never clamped."
          },
          {
            "name": "page_size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 1,
              "maximum": 200,
              "default": 20
            },
            "description": "Out of range rejects with 400; never clamped. Aliases (pageSize, limit, page_no, pageNo, per_page, size, offset) are forbidden."
          },
          {
            "name": "sandbox_instance_state",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/SandboxInstanceState"
            },
            "description": "Narrows the listing to one provisioning state."
          }
        ],
        "responses": {
          "200": {
            "description": "Standard SdkWorkApiResponse envelope (API_SPEC.md section 15)",
            "headers": {
              "x-sdkwork-trace-id": {
                "$ref": "#/components/headers/TraceId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SandboxInstanceListResponse"
                }
              }
            }
          },
          "400": {
            "description": "Client fault; unlogged at server (RFC 9457 problem document)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required (RFC 9457 problem document)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "403": {
            "description": "Permission denied (RFC 9457 problem document)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded (RFC 9457 problem document)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error (RFC 9457 problem document)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        },
        "security": [
          {
            "AuthToken": [],
            "AccessToken": []
          }
        ],
        "x-sdkwork-owner": "sdkwork-sandbox",
        "x-sdkwork-api-authority": "sdkwork-sandbox-app-api",
        "x-sdkwork-domain": "sandbox",
        "x-sdkwork-resource": "sandboxInstances",
        "x-sdkwork-public": false,
        "x-sdkwork-api-surface": "app-api",
        "x-sdkwork-request-context": "WebRequestContext",
        "x-sdkwork-wire-protocol": "sdkwork-v3"
      },
      "post": {
        "tags": [
          "sandbox"
        ],
        "summary": "Provisions one sandbox instance owned by the authenticated user",
        "operationId": "sandboxInstances.create",
        "description": "The owner is the verified caller identity from the request context and is deliberately absent from the body: a body field would let one caller provision under another's identity.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateSandboxInstanceRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Standard SdkWorkApiResponse envelope (API_SPEC.md section 15.4: create returns 201 with code 0)",
            "headers": {
              "x-sdkwork-trace-id": {
                "$ref": "#/components/headers/TraceId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SandboxInstanceItemResponse"
                }
              }
            }
          },
          "400": {
            "description": "Client fault; unlogged at server (RFC 9457 problem document)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required (RFC 9457 problem document)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "403": {
            "description": "Permission denied (RFC 9457 problem document)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "409": {
            "description": "A sandbox instance with this name already exists for this owner (RFC 9457 problem document)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded (RFC 9457 problem document)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error (RFC 9457 problem document)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        },
        "security": [
          {
            "AuthToken": [],
            "AccessToken": []
          }
        ],
        "x-sdkwork-owner": "sdkwork-sandbox",
        "x-sdkwork-api-authority": "sdkwork-sandbox-app-api",
        "x-sdkwork-domain": "sandbox",
        "x-sdkwork-resource": "sandboxInstances",
        "x-sdkwork-public": false,
        "x-sdkwork-api-surface": "app-api",
        "x-sdkwork-request-context": "WebRequestContext",
        "x-sdkwork-wire-protocol": "sdkwork-v3"
      }
    },
    "/app/v3/api/sandbox/sandbox_instances/{sandboxInstanceId}": {
      "parameters": [
        {
          "name": "sandboxInstanceId",
          "in": "path",
          "required": true,
          "schema": {
            "$ref": "#/components/schemas/SandboxInstanceId"
          },
          "description": "Server-issued opaque instance handle, scoped to the caller's tenant and owner."
        }
      ],
      "get": {
        "tags": [
          "sandbox"
        ],
        "summary": "Reads one sandbox instance owned by the authenticated user",
        "operationId": "sandboxInstances.retrieve",
        "description": "Another owner's instance inside the same tenant answers the same 404 an absent row returns: ownership is never disclosed.",
        "responses": {
          "200": {
            "description": "Standard SdkWorkApiResponse envelope (API_SPEC.md section 15)",
            "headers": {
              "x-sdkwork-trace-id": {
                "$ref": "#/components/headers/TraceId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SandboxInstanceItemResponse"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required (RFC 9457 problem document)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "403": {
            "description": "Permission denied (RFC 9457 problem document)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "404": {
            "description": "No such instance for this tenant and owner (RFC 9457 problem document)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded (RFC 9457 problem document)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error (RFC 9457 problem document)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        },
        "security": [
          {
            "AuthToken": [],
            "AccessToken": []
          }
        ],
        "x-sdkwork-owner": "sdkwork-sandbox",
        "x-sdkwork-api-authority": "sdkwork-sandbox-app-api",
        "x-sdkwork-domain": "sandbox",
        "x-sdkwork-resource": "sandboxInstances",
        "x-sdkwork-public": false,
        "x-sdkwork-api-surface": "app-api",
        "x-sdkwork-request-context": "WebRequestContext",
        "x-sdkwork-wire-protocol": "sdkwork-v3"
      },
      "patch": {
        "tags": [
          "sandbox"
        ],
        "summary": "Updates one sandbox instance owned by the authenticated user",
        "operationId": "sandboxInstances.update",
        "description": "Partial update under optimistic concurrency: the stored sandboxVersion is bumped on every accepted write and a stale writer receives 409.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateSandboxInstanceRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Standard SdkWorkApiResponse envelope (API_SPEC.md section 15)",
            "headers": {
              "x-sdkwork-trace-id": {
                "$ref": "#/components/headers/TraceId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SandboxInstanceItemResponse"
                }
              }
            }
          },
          "400": {
            "description": "Client fault; unlogged at server (RFC 9457 problem document)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required (RFC 9457 problem document)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "403": {
            "description": "Permission denied (RFC 9457 problem document)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "404": {
            "description": "No such instance for this tenant and owner (RFC 9457 problem document)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "409": {
            "description": "State transition not allowed, live instance not deletable, or version conflict (RFC 9457 problem document)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded (RFC 9457 problem document)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error (RFC 9457 problem document)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        },
        "security": [
          {
            "AuthToken": [],
            "AccessToken": []
          }
        ],
        "x-sdkwork-owner": "sdkwork-sandbox",
        "x-sdkwork-api-authority": "sdkwork-sandbox-app-api",
        "x-sdkwork-domain": "sandbox",
        "x-sdkwork-resource": "sandboxInstances",
        "x-sdkwork-public": false,
        "x-sdkwork-api-surface": "app-api",
        "x-sdkwork-request-context": "WebRequestContext",
        "x-sdkwork-wire-protocol": "sdkwork-v3"
      },
      "delete": {
        "tags": [
          "sandbox"
        ],
        "summary": "Retires one sandbox instance owned by the authenticated user",
        "operationId": "sandboxInstances.delete",
        "description": "A live (active) instance must be suspended before it can be deleted; the refusal is a 409.",
        "responses": {
          "204": {
            "description": "Deleted; no JSON body (API_SPEC.md section 15.4)",
            "headers": {
              "x-sdkwork-trace-id": {
                "$ref": "#/components/headers/TraceId"
              }
            }
          },
          "401": {
            "description": "Authentication required (RFC 9457 problem document)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "403": {
            "description": "Permission denied (RFC 9457 problem document)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "404": {
            "description": "No such instance for this tenant and owner (RFC 9457 problem document)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "409": {
            "description": "A live sandbox instance must be suspended before it can be deleted (RFC 9457 problem document)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded (RFC 9457 problem document)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error (RFC 9457 problem document)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        },
        "security": [
          {
            "AuthToken": [],
            "AccessToken": []
          }
        ],
        "x-sdkwork-owner": "sdkwork-sandbox",
        "x-sdkwork-api-authority": "sdkwork-sandbox-app-api",
        "x-sdkwork-domain": "sandbox",
        "x-sdkwork-resource": "sandboxInstances",
        "x-sdkwork-public": false,
        "x-sdkwork-api-surface": "app-api",
        "x-sdkwork-request-context": "WebRequestContext",
        "x-sdkwork-wire-protocol": "sdkwork-v3"
      }
    }
  },
  "components": {
    "securitySchemes": {
      "AuthToken": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "IAM session bearer token (Authorization: Bearer) issued at sign-in."
      },
      "AccessToken": {
        "type": "apiKey",
        "in": "header",
        "name": "Access-Token",
        "description": "IAM dual-token access credential; both credentials of the pair are required on every app-api operation (IAM_SPEC.md)."
      }
    },
    "headers": {
      "TraceId": {
        "description": "Server-owned request correlation id; clients must not supply it",
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "schemas": {
      "SdkWorkApiResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "data",
          "traceId"
        ],
        "properties": {
          "code": {
            "type": "integer",
            "format": "int32",
            "description": "Numeric success result code; MUST be 0 on HTTP 2xx (API_SPEC.md section 15.3)",
            "enum": [
              0
            ],
            "default": 0
          },
          "data": {
            "description": "Operation-specific payload; typed per operation through allOf"
          },
          "traceId": {
            "type": "string",
            "format": "uuid",
            "description": "Server-owned request correlation id; clients must not supply this value"
          }
        }
      },
      "ProblemDetail": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "type",
          "title",
          "status",
          "code",
          "traceId"
        ],
        "properties": {
          "type": {
            "type": "string",
            "format": "uri-reference"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "minimum": 100,
            "maximum": 599
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string",
            "description": "Request endpoint occurrence: {METHOD} {routeTemplate}"
          },
          "operationId": {
            "type": "string"
          },
          "code": {
            "type": "integer",
            "format": "int32",
            "description": "Numeric error result code; MUST be non-zero (API_SPEC.md section 15.3)",
            "minimum": 40001,
            "maximum": 79999
          },
          "traceId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "SandboxInstanceId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "SandboxOwnerId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "description": "Server-derived from the verified principal; never client-supplied."
      },
      "SandboxVersion": {
        "type": "string",
        "format": "int64",
        "pattern": "^[0-9]+$",
        "minLength": 1,
        "x-sdkwork-int64-string": true,
        "x-sdkwork-rust-type": "u64",
        "description": "Optimistic-concurrency version; int64-as-string per API_SPEC.md section 13.6"
      },
      "SandboxInstanceState": {
        "type": "string",
        "enum": [
          "requested",
          "active",
          "suspended",
          "terminated",
          "failed"
        ]
      },
      "SandboxInstanceProfile": {
        "type": "string",
        "enum": [
          "standard",
          "memory_optimized",
          "compute_optimized"
        ]
      },
      "SandboxIsolationAssurance": {
        "type": "string",
        "enum": [
          "host_user",
          "container",
          "user_space_kernel",
          "micro_vm",
          "dedicated_vm"
        ]
      },
      "SandboxRuntimeCapability": {
        "type": "string",
        "enum": [
          "build",
          "browser",
          "environment",
          "filesystem",
          "git",
          "mcp_transport",
          "port_forward",
          "terminal"
        ]
      },
      "OffsetPageInfo": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "mode"
        ],
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "offset"
            ]
          },
          "page": {
            "type": "integer",
            "format": "int32",
            "minimum": 1,
            "description": "Effective 1-based page number for this response"
          },
          "pageSize": {
            "type": "integer",
            "format": "int32",
            "minimum": 1,
            "maximum": 200,
            "description": "Effective page size for this response"
          },
          "totalItems": {
            "type": "string",
            "format": "int64",
            "pattern": "^[0-9]+$",
            "x-sdkwork-int64-string": true,
            "description": "Exact number of instances in the caller's owned scope; int64-as-string per API_SPEC.md section 13.6"
          },
          "totalPages": {
            "type": "integer",
            "format": "int32",
            "minimum": 0,
            "description": "ceil(totalItems / pageSize); 0 when the scope is empty"
          },
          "hasMore": {
            "type": "boolean",
            "description": "Whether a page after this one exists"
          }
        }
      },
      "SandboxInstancePageData": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "items",
          "pageInfo"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SandboxInstance"
            }
          },
          "pageInfo": {
            "$ref": "#/components/schemas/OffsetPageInfo"
          }
        }
      },
      "SandboxInstanceResourceData": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "item"
        ],
        "properties": {
          "item": {
            "$ref": "#/components/schemas/SandboxInstance"
          }
        }
      },
      "SandboxInstanceListResponse": {
        "allOf": [
          {
            "$ref": "#/components/schemas/SdkWorkApiResponse"
          },
          {
            "type": "object",
            "properties": {
              "data": {
                "$ref": "#/components/schemas/SandboxInstancePageData"
              }
            }
          }
        ]
      },
      "SandboxInstanceItemResponse": {
        "allOf": [
          {
            "$ref": "#/components/schemas/SdkWorkApiResponse"
          },
          {
            "type": "object",
            "properties": {
              "data": {
                "$ref": "#/components/schemas/SandboxInstanceResourceData"
              }
            }
          }
        ]
      },
      "CreateSandboxInstanceRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sandboxInstanceName",
          "sandboxInstanceProfile",
          "sandboxInstanceBaseImage",
          "sandboxInstanceVcpuCount",
          "sandboxInstanceMemoryMb",
          "sandboxInstanceDiskMb",
          "sandboxInstanceMinimumAssurance"
        ],
        "properties": {
          "sandboxInstanceName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "sandboxInstanceProfile": {
            "$ref": "#/components/schemas/SandboxInstanceProfile"
          },
          "sandboxInstanceBaseImage": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "sandboxInstanceVcpuCount": {
            "type": "integer",
            "format": "int32",
            "minimum": 1,
            "maximum": 64
          },
          "sandboxInstanceMemoryMb": {
            "type": "integer",
            "format": "int32",
            "minimum": 256,
            "maximum": 262144
          },
          "sandboxInstanceDiskMb": {
            "type": "integer",
            "format": "int32",
