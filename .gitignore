# Vendored upstream reference sources (E2B alignment study).
# Read-only local clones used for source-level parity analysis. Never
# committed: upstream code is not this repository's property, and this
# repository records parity via identifiers in specs/, not vendored bodies.
/external/

# SDK generated-package build artifacts (generator-owned sources are committed;
# dist/, target/, and node_modules/ are reproducible build output)
sdks/**/generated/server-openapi/dist/
sdks/**/generated/server-openapi/target/
sdks/**/generated/server-openapi/node_modules/

# Local tooling config (do not commit)
.zcodeignore

